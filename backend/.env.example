# Copier ce fichier en ".env" et remplir avec tes propres clés

# TMDB : https://www.themoviedb.org/settings/api
TMDB_API_KEY=ta_cle_tmdb_ici

# Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=ta_cle_gemini_ici

# Optionnel : override du modèle Gemini utilisé (voir la liste à jour sur
# https://ai.google.dev/gemini-api/docs/models). Google fait évoluer ses noms
# de modèles assez souvent — si tu as une erreur 404 sur /suggest, c'est
# probablement ce nom qu'il faut changer ici.
GEMINI_MODEL=gemini-2.5-flash-lite

# Origine autorisée pour les appels CORS depuis le frontend
FRONTEND_ORIGIN=http://localhost:3000
